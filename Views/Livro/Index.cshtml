@model List<Livro>
@{
    ViewData["Title"] = "Biblioteca";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="display-4 mb-0">Biblioteca</h1>

    <a class="btn btn-primary add"
       role="button"
       asp-controller="Livro"
       asp-action="Criar">
        Adicionar Livro
    </a>

</div>


    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-5">

        @if (Model != null && Model.Any())
        {
            foreach (Livro livro in Model)
            {
                <div class="col">
                    <div class="card shadow-sm h-100  ">

                        <img src="@livro.CapaUrl"
                             class="card-img-top"
                             alt="Capa de @livro.Titulo"
                             style="height: 400px; object-fit: contain;">

                        <div class="card-body ">

                            <h5 class="card-title">
                                @livro.Titulo
                            </h5>

                            <p class="card-text">
                                <strong>Autor:</strong> @livro.Autor<br>
                                <strong>Gênero:</strong> @livro.Genero<br>
                                <strong>Ano:</strong> @livro.AnoPublicacao
                            </p>

                            <div class="d-flex gap-2">

                                <a class="btn btn-primary botao"
                                   asp-controller="Livro"
                                   asp-action="Editar"
                                   asp-route-id="@livro.Id">
                                    Editar
                                </a>

                                <form asp-controller="Livro"
                                      asp-action="Excluir"
                                      method="post">

                                    <input type="hidden"
                                           name="Id"
                                           value="@livro.Id" />

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Excluir
                                    </button>

                                </form>

                            </div>

                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>