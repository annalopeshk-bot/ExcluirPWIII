@model Livro
@{
    ViewData["Title"] = 
            ViewBag.TipoTela == "Criar"
            ? "Cadastrar Livro"
            : "Editar Livro";
}

<div class="text-center">
    <h1 class="display-4">
        @(
            ViewBag.TipoTela == "Criar" 
            ? "Cadastrar Livro" 
            : "Editar Livro"
        )
    </h1>
</div>

<form asp-controller="Livro" 
      asp-action="@(
                       ViewBag.TipoTela == "Criar" 
                       ? "Criar"
                       : "Editar"
                    )"
      method="POST"
>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label for="titulo" class="form-label">Título</label>
        <input type="text" asp-for="Titulo" class="form-control"
            placeholder="Digite o título do livro"
        />
    </div>

    <div class="mb-3">
        <label for="autor" class="form-label">Autor</label>
        <input type="text" asp-for="Autor" class="form-control"
               placeholder="Digite o autor do livro" />
    </div>

    <div class="mb-3">
        <label for="genero" class="form-label">Gênero</label>
        <input type="text" asp-for="Genero" class="form-control"
               placeholder="Digite o gênero do livro" />
    </div>

    <div class="mb-3">
        <label for="anoPublicacao" class="form-label">Ano de Publicação</label>
        <input type="text" asp-for="AnoPublicacao" class="form-control"
               placeholder="Digite o ano de publicação do livro" />
    </div>

    <div class="mb-3">
        <label for="capaUrl" class="form-label">URL da Capa</label>
        <input type="text" asp-for="CapaUrl" class="form-control"
               placeholder="Digite a URL da capa do livro" />
    </div>

    <button
        type="submit" class="btn btn-primary d-block w-100 mb-3 botao"
    >
        @(ViewBag.TipoTela == "Criar" ? "Cadastrar" : "Editar")
    </button>
    <a
        class="btn btn-secondary d-block w-100 mb-3"
        asp-controller="Livro"
        asp-action="Index"
    >
        Voltar
    </a>
</form>